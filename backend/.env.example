# -------------------------------------------------------
# Welfare Intelligence Platform — Backend Environment Config
# -------------------------------------------------------
# Copy this file to backend/.env and fill in your values.
# backend/.env is gitignored and MUST NEVER be committed.
# -------------------------------------------------------

# -------------------------------------------------------
# Supabase / PostgreSQL Connection
# -------------------------------------------------------
# Default: Local Docker container (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/postgres

# To use Supabase, comment the line above and uncomment below:
# Direct connection (port 5432) — recommended for local FastAPI + SQLAlchemy asyncpg
# DATABASE_URL=postgresql+asyncpg://postgres:your_supabase_password@db.your_project_ref.supabase.co:5432/postgres

# -------------------------------------------------------
# Application Settings
# -------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# -------------------------------------------------------
# CORS — comma-separated allowed origins (no trailing slash)
# -------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------
# Connection Pool (optional — defaults shown)
# -------------------------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
